#!/usr/bin/env bash
# Switch single monitors off and back on from the Omarchy menu.
#
#   monitor-power toggle <output>   off if it is on, on if it is off
#   monitor-power off <output>      disable the output
#   monitor-power on <output>...    enable them again
#   monitor-power is-on <output>    exit 0 when the output is enabled
#   monitor-power known <output>    exit 0 when the output is connected
#   monitor-power list              every connected output and its state
#   monitor-power sync-menu         write the Trigger > Monitors rows
#   monitor-power remove-menu       take those rows out again
#
# "Off" disables the output rather than blanking it with DPMS. A panel that
# is only blanked falls asleep, drops off the DisplayPort link and comes
# straight back as a fresh monitor, which Hyprland lights up again - so DPMS
# off does not last. A disabled output stays dark until it is enabled.
#
# Which outputs are off is kept for the current Hyprland session only, in
# $XDG_RUNTIME_DIR. monitor-power.lua reads it on every config reload so a
# reload does not bring a monitor back, and ignores it once Hyprland has
# restarted, so a new session always starts with every monitor on.

set -euo pipefail

here=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)
self="$here/monitor-power"

state_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/omarchy-monitor-power"
state_file="$state_dir/off"
known_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-monitor-power"
known_file="$known_dir/known"
menu_file="$HOME/.config/omarchy/extensions/omarchy-menu.jsonc"
menu_begin="// >>> monitor-power >>>"
menu_end="// <<< monitor-power <<<"
instance="${HYPRLAND_INSTANCE_SIGNATURE:-}"

die() { echo "monitor-power: $*" >&2; exit 1; }

notify() {
  command -v notify-send >/dev/null 2>&1 || return 0
  notify-send -a "Monitor Power" -i video-display "$@" || true
}

valid_name() {
  [[ $1 =~ ^[A-Za-z0-9_.-]+$ ]] || die "not an output name: $1"
}

monitors() { hyprctl monitors all -j; }

# The state file, but only when it was written by this Hyprland instance.
# Line one is "instance <signature>"; every other line is
# "<output> <mode> <position> <scale> <transform>", the output as it was
# when it went off, so it can come back exactly as it was in one step.
state_lines() {
  [[ -f $state_file ]] || return 0
  local first
  first=$(head -n1 "$state_file")
  [[ $first == "instance $instance" ]] || return 0
  tail -n +2 "$state_file"
}

write_state() {
  mkdir -p "$state_dir"
  local tmp="$state_file.$$"
  { echo "instance $instance"; cat; } > "$tmp"
  mv "$tmp" "$state_file"
}

is_connected() {
  monitors | jq -e --arg n "$1" 'any(.[]; .name == $n)' >/dev/null
}

is_enabled() {
  monitors | jq -e --arg n "$1" 'any(.[]; .name == $n and .disabled == false)' >/dev/null
}

# Enabled with a real mode. A panel still waking up can come back as
# enabled at 0x0, which shows nothing.
is_lit() {
  monitors | jq -e --arg n "$1" \
    'any(.[]; .name == $n and .disabled == false and .width > 0 and .height > 0)' >/dev/null
}

cmd_off() {
  local name=$1
  valid_name "$name"
  is_connected "$name" || die "$name is not connected"
  is_enabled "$name" || return 0

  local lit
  lit=$(monitors | jq '[.[] | select(.disabled == false)] | length')
  if (( lit <= 1 )); then
    notify "Monitor Power" "$name is the only monitor on - keeping it on."
    die "$name is the last enabled monitor"
  fi

  local spec
  spec=$(monitors | jq -r --arg n "$name" '.[] | select(.name == $n) |
    "\(.width)x\(.height)@\(.refreshRate * 100 | round / 100) \(.x)x\(.y) \(.scale) \(.transform)"')
  { state_lines | awk -v n="$name" '$1 != n'; echo "$name $spec"; } | write_state
  hyprctl eval "hl.monitor({ output = '$name', disabled = true })" >/dev/null
}

# Enable in one step: a single monitor rule with the output's recorded mode,
# position and scale and disabled = false. A config reload is the obvious
# way back, but it turns the output on before a sleeping panel has woken:
# the output comes up with no mode (0x0, scale 0), every Wayland client sees
# that output appear, and Chromium-based browsers crash on it. The one-step
# rule has the panel lit at its real mode on the first check.
#
# Once it is lit, a reload puts back anything else monitors.lua sets for it
# (vrr, bitdepth, ...) without touching the mode.
wait_lit() {
  local name=$1
  for _ in $(seq 1 20); do
    is_lit "$name" && return 0
    sleep 0.25
  done
  return 1
}

cmd_on() {
  local name spec lines failed=()
  for name in "$@"; do valid_name "$name"; done
  lines=$(state_lines)
  for name in "$@"; do
    spec=$(awk -v n="$name" '$1 == n { print $2, $3, $4, $5; exit }' <<<"$lines")
    lines=$(awk -v n="$name" '$1 != n' <<<"$lines")
    printf '%s\n' "$lines" | sed '/^$/d' | write_state
    is_connected "$name" && ! is_lit "$name" || continue

    local mode position scale transform
    read -r mode position scale transform <<<"${spec:-preferred auto auto 0}"
    [[ $scale =~ ^[0-9.]+$ ]] || scale='"auto"'
    [[ $transform =~ ^[0-9]+$ ]] || transform=0
    hyprctl eval "hl.monitor({ output = '$name', disabled = false, mode = '$mode', position = '$position', scale = $scale, transform = $transform })" >/dev/null
    wait_lit "$name" || failed+=("$name")
  done

  if (( ${#failed[@]} )); then
    notify "Monitor Power" "${failed[*]} did not come back with a picture."
    return 1
  fi
  hyprctl reload >/dev/null
}

cmd_toggle() {
  local name=$1
  valid_name "$name"
  if is_enabled "$name"; then cmd_off "$name"; else cmd_on "$name"; fi
}

cmd_list() {
  monitors | jq -r '.[] | "\(.name)\t\(if .disabled then "off" else "on" end)\t\(.make) \(.model)"'
}

# Outputs seen so far, so a monitor keeps its row while it is unplugged
# (the row hides itself) and while it is disabled. Line format:
# "<output>\t<x>\t<make>\t<model>".
update_known() {
  mkdir -p "$known_dir"
  local seen
  seen=$(monitors | jq -r '.[] | select(.disabled == false) | "\(.name)\t\(.x)\t\(.make)\t\(.model)"')
  local disabled
  disabled=$(monitors | jq -r '.[] | select(.disabled) | "\(.name)\t\t\(.make)\t\(.model)"')
  {
    [[ -f $known_file ]] && cat "$known_file"
    printf '%s\n' "$seen"
    printf '%s\n' "$disabled"
  } | awk -F'\t' '
    NF < 1 || $1 == "" { next }
    !($1 in make) { order[++count] = $1 }
    { make[$1] = $3; model[$1] = $4; if ($2 != "") x[$1] = $2 }
    END {
      for (i = 1; i <= count; i++) {
        n = order[i]
        printf "%s\t%s\t%s\t%s\n", n, (n in x ? x[n] : 999999), make[n], model[n]
      }
    }
  ' | sort -t$'\t' -k2,2n -k1,1 > "$known_file.$$"
  mv "$known_file.$$" "$known_file"
}

json() { jq -Rn --arg s "$1" '$s'; }
sq() { printf "'%s'" "${1//\'/\'\\\'\'}"; }

menu_block() {
  local count
  count=$(wc -l < "$known_file")
  echo "  $menu_begin"
  echo "  // Monitor Power. Written by dev.cstav.omarchy.plugin.monitor-power"
  echo "  // (bin/monitor-power sync-menu); rewritten whenever a new monitor shows up."
  echo "  // A row carries a check while its monitor is on; pick it to switch it."
  echo '  "trigger.monitors": {"icon":"󰍺","label":"Monitors","aliases":["monitors","displays","screens","monitor-power"]},'
  # A JSON escape, handed to printf as an argument so printf leaves it alone.
  local icon='\udb80\udf79'
  local i=0 name x make model where label id ctl
  # "$HOME/..." reads better in the jsonc than the expanded path; fall back
  # to single quotes for a path a double-quoted string would misread.
  if [[ $self == "$HOME"/* && $self != *[\"\$\`\\]* ]]; then
    ctl="\"\$HOME${self#"$HOME"}\""
  else
    ctl=$(sq "$self")
  fi
  while IFS=$'\t' read -r name x make model; do
    [[ -n $name ]] || continue
    i=$((i + 1))
    case "$count:$i" in
      2:1) where="Left" ;; 2:2) where="Right" ;;
      3:1) where="Left" ;; 3:2) where="Middle" ;; 3:3) where="Right" ;;
      1:1) where="" ;;
      *) where="Screen $i" ;;
    esac
    # The menu card is narrow and the check mark goes after the label, so
    # the label stays short; the rest goes in the subtitle.
    label="${where:+$where · }${model%% *}"
    id="trigger.monitors.${name//./-}"
    printf '  %s: {"icon":"%s","label":%s,"description":%s,"when":%s,"checked":%s,"action":%s},\n' \
      "$(json "$id")" \
      "$icon" \
      "$(json "$label")" \
      "$(json "$make $model · $name")" \
      "$(json "test -x $ctl && $ctl known $name")" \
      "$(json "$ctl is-on $name")" \
      "$(json "$ctl toggle $name")"
  done < "$known_file"
  echo "  $menu_end"
}

strip_block() {
  awk -v b="$menu_begin" -v e="$menu_end" '
    index($0, b) { skip = 1; next }
    skip && index($0, e) { skip = 0; next }
    !skip
  '
}

cmd_sync_menu() {
  update_known
  mkdir -p "$(dirname "$menu_file")"
  [[ -s $menu_file ]] || printf '{\n}\n' > "$menu_file"
  local block current next
  block=$(menu_block)
  current=$(cat "$menu_file")
  # Insert right after the object's opening brace.
  # ENVIRON, not -v: awk -v would read the icon escapes as its own.
  next=$(strip_block <<<"$current" | MENU_BLOCK="$block" awk '
    !done && /^[[:space:]]*\{[[:space:]]*$/ { print; print ENVIRON["MENU_BLOCK"]; done = 1; next }
    { print }
  ')
  [[ $next == "$current" ]] && return 0
  printf '%s\n' "$next" > "$menu_file.$$"
  mv "$menu_file.$$" "$menu_file"
}

cmd_remove_menu() {
  [[ -f $menu_file ]] || return 0
  strip_block < "$menu_file" > "$menu_file.$$"
  mv "$menu_file.$$" "$menu_file"
}

[[ $# -ge 1 ]] || { sed -n '2,11p' "$self" | sed 's/^# \{0,1\}//'; exit 2; }
command=$1; shift
case "$command" in
  off|on|toggle|is-on|known) [[ $# -ge 1 ]] || die "$command needs an output name" ;;
esac
case "$command" in
  off) cmd_off "$1" ;;
  on) cmd_on "$@" ;;
  toggle) cmd_toggle "$1" ;;
  is-on) valid_name "$1"; is_enabled "$1" ;;
  known) valid_name "$1"; is_connected "$1" ;;
  list) cmd_list ;;
  sync-menu) cmd_sync_menu ;;
  remove-menu) cmd_remove_menu ;;
  *) die "unknown command: $command" ;;
esac
